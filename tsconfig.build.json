{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,

    /* strict mode for production */
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src"]
}