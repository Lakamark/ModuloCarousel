{
  "name": "@lakamark/modulo-carousel",
  "version": "0.1.0",
  "description": "A modular and lightweight carousel library.",
  "license": "MIT",
  "author": "Marc-Antoine Lacasse",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lakamark/ModuloCarousel.git"
  },
  "homepage": "https://github.com/lakamark/ModuloCarousel#readme",
  "bugs": {
    "url": "https://github.com/lakamark/ModuloCarousel/issues"
  },
  "keywords": [
    "carousel",
    "slider",
    "typescript",
    "javascript",
    "ui",
    "library",
    "plugin"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "jsdom": "^29.0.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.1",
    "vitest": "^4.1.2"
  }
}
